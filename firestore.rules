rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function currentEmail() {
      return isSignedIn() ? request.auth.token.email.lower() : '';
    }

    function isPrimaryAdmin() {
      return currentEmail() == 'zivit.reshef@gmail.com';
    }

    function isOwnerOfResource(data) {
      return isPrimaryAdmin() ||
        (isSignedIn() && data.ownerEmail != null && data.ownerEmail.lower() == currentEmail());
    }

    function isSharedOnResource(data) {
      return isSignedIn() &&
        data.sharedWith is list &&
        currentEmail() in data.sharedWith;
    }

    // Global configuration (allowed users, goal bank, admin requests, settings)
    match /tala_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Student plans & status reports
    match /tala_students/{studentId} {
      allow read: if !isSignedIn() ||
        isOwnerOfResource(resource.data) ||
        isSharedOnResource(resource.data) ||
        resource.data.ownerEmail == null ||
        resource.data.ownerEmail == '';

      allow create: if !isSignedIn() ||
        isOwnerOfResource(request.resource.data) ||
        request.resource.data.ownerEmail == null;

      // Prevent non-owners from hijacking ownerEmail or archiving a shared student
      allow update: if (
        !isSignedIn() ||
        isOwnerOfResource(resource.data) ||
        isSharedOnResource(resource.data)
      ) && (
        // Shared teachers cannot change ownerEmail or toggle archived status
        resource.data.ownerEmail == null ||
        request.resource.data.ownerEmail == resource.data.ownerEmail
      ) && (
        !isSignedIn() ||
        isOwnerOfResource(resource.data) ||
        request.resource.data.archived == resource.data.archived
      );

      // Only the student's owner (or primary admin) can delete a student
      allow delete: if !isSignedIn() || isOwnerOfResource(resource.data);
    }

    // Parent / student input invites. The doc ID is a 128-bit random token (capability URL).
    function answerOk(responses, key) {
      return !(key in responses) ||
        (responses[key] is string && responses[key].size() <= 1500);
    }

    function isInviteOwner(data) {
      return isPrimaryAdmin() || (isSignedIn() && data.ownerEmail == currentEmail());
    }

    match /tala_invites/{token} {
      // Anyone holding the exact token can read that single doc; listing is owner-only.
      allow get: if true;
      allow list: if isInviteOwner(resource.data);

      allow create: if isSignedIn() &&
        token.size() == 22 &&
        request.resource.data.ownerEmail == currentEmail() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(8, 'd') &&
        !('responses' in request.resource.data);

      // Owner may manage freely. The anonymous respondent may do exactly one thing:
      // flip a still-pending, non-expired invite to 'submitted' with bounded answers.
      allow update: if isInviteOwner(resource.data) || (
        resource.data.status == 'pending' &&
        request.time < resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'responses', 'submittedAt']) &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.responses is map &&
        request.resource.data.responses.keys().hasOnly(['strengths', 'challenges', 'goal']) &&
        answerOk(request.resource.data.responses, 'strengths') &&
        answerOk(request.resource.data.responses, 'challenges') &&
        answerOk(request.resource.data.responses, 'goal')
      );

      allow delete: if isInviteOwner(resource.data);
    }

    // Per-user rate limit counter — users can only touch their own doc
    match /ai_rate_limits/{userId} {
      allow read, write: if isSignedIn() && currentEmail() == userId;
    }

    // Audit log — completely locked down for clients
    // Only the Cloud Function (Admin SDK) can write; no client read/write
    match /ai_audit_logs/{logId} {
      allow read, write: if false;
    }
  }
}
