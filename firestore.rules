rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email != '') ||
        (request.auth.token.role != null) ||
        (request.auth.uid != null && request.auth.uid.matches('^tala_.*'))
      );
    }

    function currentEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isPrimaryAdmin() {
      return currentEmail() == 'zivit.reshef@gmail.com' ||
        currentEmail() == 'moti.reshef@gmail.com' ||
        currentEmail() == 'moti_reshef@bmc.com' ||
        (request.auth != null && (
          request.auth.uid == 'tala_ccd05b8d703389243cd80ff9' ||
          request.auth.uid == 'tala_5599a5e99afe3b3f4e1e8514'
        ));
    }

    function isOwnerOfResource(data) {
      return isAdmin() ||
        (isSignedIn() && data.ownerEmail != null && (
          (currentEmail() != '' && data.ownerEmail == currentEmail()) ||
          (data.ownerUid != null && request.auth.uid == data.ownerUid)
        ));
    }

    function isSharedOnResource(data) {
      return isSignedIn() &&
        data.sharedWith is list &&
        currentEmail() in data.sharedWith;
    }

    function isAdmin() {
      return isPrimaryAdmin() ||
        (isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.isAdmin == true));
    }

    // Users list: admin read only. All writes go through the talaConfigWrite /
    // talaLogin Cloud Functions (Admin SDK bypasses rules), never from clients.
    match /tala_config/allowed_users {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /tala_config/admin_requests {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-published, non-secret views of the users list.
    match /tala_config/directory {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /tala_profiles/{key} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.email.lower() == currentEmail());
      allow write: if false;
    }

    match /tala_config/settings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tala_config/goal_bank {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tala_config/presence {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /tala_sessions/{key} {
      // Teachers can only read and manage their own session document; admins can inspect all
      allow read: if isAdmin() || (isSignedIn() && key == currentEmail().replace('[^a-z0-9._-]', '_'));
      allow write: if isAdmin() || (isSignedIn() && key == currentEmail().replace('[^a-z0-9._-]', '_'));
    }
    match /tala_config/students_migration_meta {
      allow read, write: if isAdmin();
    }

    // System-health telemetry (AI failures / local-engine fallbacks). Any signed-in client may
    // append a small, immutable event for itself; only admins can read or purge them.
    match /tala_health_events/{eventId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'kind', 'operation', 'category', 'status', 'message', 'userEmail',
          'createdAtMs', 'createdAtIso', 'promptLength', 'stage', 'reason', 'viaDirectKey'
        ]) &&
        request.resource.data.kind is string && request.resource.data.kind.size() <= 40 &&
        request.resource.data.createdAtMs is number &&
        (!('message' in request.resource.data) ||
          (request.resource.data.message is string && request.resource.data.message.size() <= 300)) &&
        (!('userEmail' in request.resource.data) ||
          request.resource.data.userEmail == '' ||
          request.resource.data.userEmail == currentEmail());
    }

    // Student plans & status reports. Owner, shared teachers and the primary admin only.
    match /tala_students/{studentId} {
      allow read: if isOwnerOfResource(resource.data) || isSharedOnResource(resource.data);

      allow create: if isSignedIn() &&
        (isAdmin() || request.resource.data.ownerEmail == currentEmail());

      // Prevent non-owners from hijacking ownerEmail, ownerUid, or archiving a shared student
      allow update: if (
        isOwnerOfResource(resource.data) ||
        isSharedOnResource(resource.data)
      ) && (
        request.resource.data.ownerEmail == resource.data.ownerEmail
      ) && (
        !('ownerUid' in resource.data) ||
        request.resource.data.ownerUid == resource.data.ownerUid
      ) && (
        isOwnerOfResource(resource.data) ||
        (
          request.resource.data.archived == resource.data.archived &&
          request.resource.data.sharedWith == resource.data.sharedWith
        )
      );

      // Only the student's owner (or primary admin) can delete a student
      allow delete: if isOwnerOfResource(resource.data);
    }
    // Parent / student input invites. The doc ID is a 128-bit random token (capability URL).
    function answerOk(responses, key) {
      return !(key in responses) ||
        (responses[key] is string && responses[key].size() <= 1500);
    }

    function isInviteOwner(data) {
      return isAdmin() || (isSignedIn() && data.ownerEmail == currentEmail());
    }

    match /tala_invites/{token} {
      // Anyone holding the exact token can read that single doc; listing is owner-only.
      allow get: if true;
      allow list: if isInviteOwner(resource.data);

      allow create: if isSignedIn() &&
        token.size() == 22 &&
        request.resource.data.ownerEmail == currentEmail() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(8, 'd') &&
        !('responses' in request.resource.data);

      // Owner may manage freely. The anonymous respondent may do exactly one thing:
      // flip a still-pending, non-expired invite to 'submitted' with bounded answers.
      allow update: if isInviteOwner(resource.data) || (
        resource.data.status == 'pending' &&
        request.time < resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'responses', 'submittedAt']) &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.responses is map &&
        request.resource.data.responses.keys().hasOnly(['strengths', 'challenges', 'goal']) &&
        answerOk(request.resource.data.responses, 'strengths') &&
        answerOk(request.resource.data.responses, 'challenges') &&
        answerOk(request.resource.data.responses, 'goal')
      );

      allow delete: if isInviteOwner(resource.data);
    }

    // Per-user rate limit counter — strictly managed by Cloud Functions Admin SDK.
    // Client cannot read or write to artificially zero out or manipulate rate limits.
    match /ai_rate_limits/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // AI Audit log — Cloud Function writes; admins can read & delete for auditing
    match /ai_audit_logs/{logId} {
      allow read, delete: if isAdmin();
      allow write: if false;
    }

    // Email Audit log: signed-in teachers log their sent emails; admins can read & purge
    match /tala_email_audit_logs/{logId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'createdAtMs', 'userEmail']) &&
        (request.resource.data.userEmail == '' || request.resource.data.userEmail.lower() == currentEmail()) &&
        request.resource.data.createdAtMs is number &&
        request.resource.data.createdAtMs <= request.time.toMillis() + 60000;
    }
  }
}
