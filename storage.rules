rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated teachers can upload and download student dossier files with strict security hardening
    match /dossier_files/{studentId}/{fileName} {
      // Must be authenticated and file must strictly adhere to size and extension boundaries
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 20 * 1024 * 1024
                   && request.resource.size > 0
                   && request.resource.contentType.matches('application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/msword|text/plain|text/csv|image/(png|jpeg|webp)')
                   && !fileName.matches('(?i).*\\.(exe|dll|bat|cmd|sh|ps1|vbs|js|html|htm|php|py|jar|msi|apk|bin|scr)$');
    }
    // Block all arbitrary access to other bucket paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
