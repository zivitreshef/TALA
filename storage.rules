rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated teachers can upload and download student dossier files
    match /dossier_files/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
